{
  "name": "performance-tracker-sales",
  "version": "0.4.2",
  "private": true,
  "description": "A local-first B2B outbound sales team performance tracker.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepackage:win": "npm run build",
    "package:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.performancetracker.desktop",
    "productName": "Performance Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "sample-data/outbound-performance-sample.xlsx"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
